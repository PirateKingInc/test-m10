{
  "name": "junk-magnet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && rm -f junk-magnet-poki.zip && cd dist && zip -qr ../junk-magnet-poki.zip . && cd .. && ls -l junk-magnet-poki.zip",
    "thumbnails": "node scripts/thumbnails.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
